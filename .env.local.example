# Copy to .env.local (gitignored) and fill in the blanks.
# The same keys go into Vercel -> Project -> Settings -> Environment Variables.

# --- Public. These ship in the browser bundle by design. ---
NEXT_PUBLIC_SUPABASE_URL=https://gsmfivxoprmwtbooglet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QfZsxNGW7O-QgSUOU9bhag_TdyCI7-i

# Absolute origin for canonical URLs, OG tags, and the RSS feed. On Vercel this
# falls back to VERCEL_PROJECT_PRODUCTION_URL, so it only needs setting once a
# custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://jeffreygong.dev

# --- Deliberately absent: SUPABASE_SERVICE_ROLE_KEY ---
#
# A service-role key bypasses RLS for the entire project, and this project also
# holds the quorum schema. Putting one in the web app's environment would mean
# any RCE, SSRF, or leaked env in the site could read and write the trading
# tables.
#
# Nothing in the app needs it. Embedding writes and retrieval both run in Edge
# Functions (supabase/functions/) that forward the caller's own JWT, so RLS --
# content_chunks_admin_all and posts_admin_all -- stays the enforcement point.
